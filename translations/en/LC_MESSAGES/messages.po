msgid ""
"1 non trasformati, 2 ingredienti culinari, 3 trasformati, 4 ultra-"
"trasformati."
msgstr ""
"1 unprocessed, 2 processed culinary ingredients, 3 processed, 4 ultra-"
"processed."

msgid ""
"100 x (1 - media dei punti / 3), calcolato sui rischi classificati: 100 ="
" tutti trascurabili, 0 = tutti alti. Il colore segue il livello medio: "
"oltre 83 Trascurabile, 51-83 Basso, 17-50 Medio, fino a 16 Alto."
msgstr ""
"100 x (1 - average points / 3), calculated on the classified risks: 100 ="
" all negligible, 0 = all high. The colour follows the average level: "
"above 83 Negligible, 51-83 Low, 17-50 Medium, up to 16 High."

msgid ""
"100 × (1 − media dei punti ÷ 3), sui rischi disponibili: 100 = tutti "
"trascurabili, 0 = tutti alti."
msgstr ""
"100 × (1 − average points ÷ 3), on the available risks: 100 = all "
"negligible, 0 = all high."

msgid "1: solo alimenti con tutti i rischi classificati e al massimo Basso"
msgstr "1: only foods with all risks classified and at most Basso (low)"

msgid ""
"9 g di proteine, 49 g di carboidrati e 3,2 g di grassi danno 36 + 196 + "
"28,8 = 260,8 Kcal."
msgstr ""
"9 g of protein, 49 g of carbohydrates and 3.2 g of fat give 36 + 196 + "
"28.8 = 260.8 Kcal."

