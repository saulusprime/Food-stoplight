#, python-format
msgid ""
"Da USDA FoodData Central (<a href=\"%(url)s\" target=\"_blank\" "
"rel=\"noopener noreferrer\">FDC %(fdc)s</a>), perché il CREA non li "
"pubblica: %(campi)s."
msgstr ""
