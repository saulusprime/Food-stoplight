msgid "Basso"
msgstr "Low"

msgid ""
"Basso fino a 55, medio 56-69, alto da 70. Carico glicemico = indice x "
"carboidrati disponibili (carboidrati - fibre) / 100; per porzione basso "
"fino a 10, medio 11-19, alto da 20."
msgstr ""
"Low up to 55, medium 56-69, high from 70. Glycemic load = index x "
"available carbohydrates (carbohydrates - fiber) / 100; per serving low up"
" to 10, medium 11-19, high from 20."

#, python-format
msgid "Bevanda con %(grammi)s g di zuccheri liberi per 100 ml."
msgstr "Drink with %(grammi)s g of free sugars per 100 ml."

msgid ""
"Bevanda zuccherata: favorisce l'aumento di peso, fattore di rischio di "
"diversi tumori."
msgstr "Sugary drink: it promotes weight gain, a risk factor for several cancers."

msgid "Bevande"
msgstr "Beverages"

msgid "C'è già una sincronizzazione in corso."
msgstr "A sync is already in progress."

msgid "CREA (codice alimento)"
msgstr "CREA (food code)"

#, python-format
