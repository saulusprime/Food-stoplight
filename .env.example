# Copia questo file in .env e personalizza i valori:
#   cp .env.example .env
# Il file .env NON va messo sotto git (è già in .gitignore).
# Le variabili d'ambiente già impostate hanno la precedenza su .env.

# Ambiente: sviluppo | produzione
APP_ENV=sviluppo

# Chiave segreta di Flask: obbligatoria in produzione (almeno 32 caratteri).
# Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Indirizzo e porta del server avviato con "python app.py"
APP_HOST=127.0.0.1
APP_PORT=5000

# Debug (default: attivo in sviluppo; in produzione è sempre disattivato)
# APP_DEBUG=true

# true: chiunque può consultare la tabella; false: serve il login anche per consultare.
# Le operazioni di scrittura richiedono sempre un utente amministratore.
ACCESSO_PUBBLICO=true

# Cookie di sessione inviati solo su HTTPS (default: attivo in produzione)
# SESSION_COOKIE_SECURE=true

# Percorsi dei database (relativi alla cartella del progetto)
# DATABASE_PATH=alimenti.db
# UTENTI_DB_PATH=utenti.db
# DIARIO_DB_PATH=diario.db

# Chiave USDA FoodData Central per "flask --app app usda-nutrienti"
# (senza, si usa la chiave pubblica DEMO_KEY, limitata a poche richieste l'ora).
# Chiave gratuita: https://fdc.nal.usda.gov/api-key-signup
# USDA_API_KEY=

# Cartella dei backup del database alimenti (automatici e manuali)
# BACKUP_DIR=instance/backup

# Dimensione massima dei file importati (CSV, Excel) e dei backup da ripristinare, in MB
# MAX_UPLOAD_MB=10

# Numero di proxy davanti all'app (Render, nginx): 1 per leggere schema e host da X-Forwarded-*
# PROXY_ATTENDIBILI=0

# Cartella dei file in attesa di conferma dell'import
# IMPORT_DIR=instance/import
